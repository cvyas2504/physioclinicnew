@{
    Layout = "_Layout";
    ViewData["Title"] = "User Master";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="fas fa-users-cog me-2"></i>User Master</h2>
        <p class="mb-0">Manage system users and their access levels</p>
    </div>
    <div>
        <a href="@Url.Action("CreateUser", "Admin")" class="btn btn-light">
            <i class="fas fa-plus me-2"></i>Add User
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">User List</h5>
        <div class="d-flex gap-2">
            <input type="text" id="searchInput" class="form-control" placeholder="Search users..." style="width: 250px;">
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="userTable" class="table table-hover">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Full Name</th>
                        <th>Role</th>
                        <th>Mobile</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Created Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function() {
        loadUsers();

        $('#searchInput').on('keyup', function() {
            loadUsers();
        });
    });

    function loadUsers() {
        $.get('@Url.Action("GetUsers", "Admin")', function(data) {
            console.log('Users data:', data);
            var tbody = $('#userTable tbody');
            tbody.empty();

            if (!data || data.length === 0) {
                tbody.append('<tr><td colspan="8" class="text-center text-muted py-4">No users found</td></tr>');
                return;
            }

            var search = $('#searchInput').val().toLowerCase();
            data = data.filter(function(u) {
                return (u.Username || '').toLowerCase().includes(search) ||
                       (u.FullName || '').toLowerCase().includes(search) ||
                       (u.Role || '').toLowerCase().includes(search);
            });

            data.forEach(function(u) {
                var roleBadge = u.Role === 'Admin' ? 'bg-danger' : u.Role === 'Physiotherapist' ? 'bg-info' : 'bg-secondary';
                var statusBadge = u.IsActive 
                    ? '<span class="badge bg-success">Active</span>' 
                    : '<span class="badge bg-secondary">Inactive</span>';
                
                tbody.append(`
                    <tr>
                        <td><strong>${u.Username || ''}</strong></td>
                        <td>${u.FullName || ''}</td>
                        <td><span class="badge ${roleBadge}">${u.Role || ''}</span></td>
                        <td>${u.MobileNumber || '-'}</td>
                        <td>${u.Email || '-'}</td>
                        <td>${statusBadge}</td>
                        <td>${u.CreatedDate || ''}</td>
                        <td>
                            <a href="@Url.Action("EditUser", "Admin")/${u.Id}" class="btn btn-sm btn-primary" title="Edit">
                                <i class="fas fa-edit"></i>
                            </a>
                            ${u.Username !== 'admin' ? `
                            <a href="@Url.Action("DeleteUser", "Admin")/${u.Id}" class="btn btn-sm btn-danger" title="Delete" onclick="return confirm('Are you sure?')">
                                <i class="fas fa-trash"></i>
                            </a>` : ''}
                        </td>
                    </tr>
                `);
            });
        }).fail(function(err) {
            console.log('Error loading users:', err);
        });
    }
</script>
}