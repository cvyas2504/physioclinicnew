@{
    Layout = "_Layout";
    ViewData["Title"] = "Patient Registration";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="fas fa-user-injured me-2"></i>Patient Registration</h2>
        <p class="mb-0">Manage patient demographics and UHID generation</p>
    </div>
    <div>
        <a href="@Url.Action("Create", "Patient")" class="btn btn-light">
            <i class="fas fa-plus me-2"></i>New Patient
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Patient List</h5>
        <div class="d-flex gap-2">
            <input type="text" id="searchInput" class="form-control" placeholder="Search by Name, UHID, Mobile..." style="width: 250px;">
            <select id="statusFilter" class="form-select" style="width: 150px;">
                <option value="all">All Status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="patientTable" class="table table-hover">
                <thead>
                    <tr>
                        <th>UHID</th>
                        <th>Patient Name</th>
                        <th>Gender</th>
                        <th>Age</th>
                        <th>Mobile</th>
                        <th>Email</th>
                        <th>Registration Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function() {
        loadPatients();

        $('#searchInput, #statusFilter').on('change keyup', function() {
            loadPatients();
        });
    });

    function loadPatients() {
        var search = $('#searchInput').val();
        var status = $('#statusFilter').val();

        $.get('@Url.Action("GetAll", "Patient")', { search: search, status: status }, function(data) {
            console.log('Data received:', data);
            var tbody = $('#patientTable tbody');
            tbody.empty();

            if (!data || data.length === 0) {
                tbody.append('<tr><td colspan="9" class="text-center text-muted py-4">No patients found</td></tr>');
                return;
            }

            data.forEach(function(p) {
                var statusBadge = p.IsActive 
                    ? '<span class="badge bg-success">Active</span>' 
                    : '<span class="badge bg-secondary">Inactive</span>';
                
                tbody.append(`
                    <tr>
                        <td><strong>${p.UHID || ''}</strong></td>
                        <td>${p.PatientName || ''}</td>
                        <td>${p.Gender || ''}</td>
                        <td>${p.Age || '-'}</td>
                        <td>${p.MobileNumber || '-'}</td>
                        <td>${p.Email || '-'}</td>
                        <td>${p.RegistrationDate || ''}</td>
                        <td>${statusBadge}</td>
                        <td>
                            <a href="@Url.Action("Edit", "Patient")/${p.Id}" class="btn btn-sm btn-primary" title="Edit">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a href="@Url.Action("Delete", "Patient")/${p.Id}" class="btn btn-sm btn-danger" title="Delete" onclick="return confirm('Are you sure?')">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                `);
            });
        }).fail(function(err) {
            console.log('Error:', err);
        });
    }
</script>
}