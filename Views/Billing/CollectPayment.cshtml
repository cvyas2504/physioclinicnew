@model PhysioClinicPro.Models.ViewModels.BillPaymentViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Collect Payment";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="fas fa-rupee-sign me-2"></i>Collect Payment</h2>
        <p class="mb-0">Bill No: @ViewBag.BillNumber</p>
    </div>
    <div>
        <a href="@Url.Action("Index", "Billing")" class="btn btn-light">
            <i class="fas fa-arrow-left me-2"></i>Back to List
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Payment Information</h5>
            </div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tr>
                        <td><strong>Bill Number:</strong></td>
                        <td>@ViewBag.BillNumber</td>
                    </tr>
                    <tr>
                        <td><strong>Patient:</strong></td>
                        <td>@ViewBag.PatientName</td>
                    </tr>
                    <tr>
                        <td><strong>Due Amount:</strong></td>
                        <td class="text-danger fs-5">₹@ViewBag.DueAmount.ToString("N2")</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-credit-card me-2"></i>Payment Details</h5>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("CollectPayment", "Billing", FormMethod.Post))
                {
                    @Html.HiddenFor(m => m.BillId)

                    <div class="mb-3">
                        <label class="form-label">Payment Amount <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.Amount, new { @class = "form-control", type = "number", step = "0.01", required = "required" })
                        <small class="text-muted">Due amount: ₹@ViewBag.DueAmount.ToString("N2")</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Payment Mode <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.PaymentMode, new SelectList(new[] { "Cash", "Card", "UPI", "Net Banking", "Cheque" }), new { @class = "form-select" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Payment Reference</label>
                        @Html.TextBoxFor(m => m.PaymentReference, new { @class = "form-control", placeholder = "Card/UPI/Check No (optional)" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        @Html.TextAreaFor(m => m.PaymentNotes, new { @class = "form-control", rows = "2", placeholder = "Any additional notes" })
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-check me-2"></i>Receive Payment
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>