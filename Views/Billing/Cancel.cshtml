@model PhysioClinicPro.Models.ViewModels.BillOperationViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Cancel Bill";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="fas fa-times-circle me-2"></i>Cancel Bill</h2>
        <p class="mb-0">Cancel bill @Model.BillNumber</p>
    </div>
    <div>
        <a href="@Url.Action("Index", "Billing")" class="btn btn-light">
            <i class="fas fa-arrow-left me-2"></i>Back to List
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Warning</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <p><strong>Bill Number:</strong> @Model.BillNumber</p>
                    <p><strong>Net Amount:</strong> ₹@Model.CurrentAmount.ToString("N2")</p>
                </div>
                <p>Cancelling this bill will:</p>
                <ul>
                    <li>Mark the bill as cancelled</li>
                    <li>Update the patient ledger</li>
                    <li>Reduce the due amount</li>
                </ul>
                <p class="text-muted">This action cannot be undone.</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-sticky-note me-2"></i>Cancellation Reason</h5>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("Cancel", "Billing", FormMethod.Post))
                {
                    @Html.HiddenFor(m => m.BillId)
                    @Html.HiddenFor(m => m.BillNumber)
                    @Html.HiddenFor(m => m.CurrentAmount)

                    <div class="mb-3">
                        <label class="form-label">Reason for Cancellation <span class="text-danger">*</span></label>
                        @Html.TextAreaFor(m => m.Reason, new { @class = "form-control", rows = "4", placeholder = "Enter the reason for cancellation", required = "required" })
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-times me-2"></i>Confirm Cancellation
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>