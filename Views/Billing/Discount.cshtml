@model PhysioClinicPro.Models.ViewModels.BillOperationViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Apply Discount";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="fas fa-percent me-2"></i>Apply Discount</h2>
        <p class="mb-0">Discount for Bill @Model.BillNumber</p>
    </div>
    <div>
        <a href="@Url.Action("Index", "Billing")" class="btn btn-light">
            <i class="fas fa-arrow-left me-2"></i>Back to List
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Bill Information</h5>
            </div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tr>
                        <td><strong>Bill Number:</strong></td>
                        <td>@Model.BillNumber</td>
                    </tr>
                    <tr>
                        <td><strong>Current Net Amount:</strong></td>
                        <td>₹@Model.CurrentAmount.ToString("N2")</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="fas fa-tag me-2"></i>Discount Details</h5>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("Discount", "Billing", FormMethod.Post))
                {
                    @Html.HiddenFor(m => m.BillId)
                    @Html.HiddenFor(m => m.BillNumber)
                    @Html.HiddenFor(m => m.CurrentAmount)

                    <div class="mb-3">
                        <label class="form-label">Discount Amount (₹) <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.Amount, new { @class = "form-control", type = "number", step = "0.01", max = Model.CurrentAmount, required = "required" })
                        <small class="text-muted">Maximum discount: ₹@Model.CurrentAmount.ToString("N2")</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Reason for Discount <span class="text-danger">*</span></label>
                        @Html.TextAreaFor(m => m.Reason, new { @class = "form-control", rows = "3", placeholder = "Enter the reason for discount (e.g., festive offer, loyalty discount)", required = "required" })
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-check me-2"></i>Apply Discount
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>