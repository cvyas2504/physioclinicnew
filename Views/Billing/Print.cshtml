@model PhysioClinicPro.Models.Bill
@{
    Layout = null;
    var clinic = ViewBag.Clinic as PhysioClinicPro.Models.ClinicProfile;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Bill - @Model.BillNumber</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        body { font-family: 'Segoe UI', sans-serif; font-size: 14px; }
        .bill-header { border-bottom: 3px solid #2E7D32; padding-bottom: 15px; margin-bottom: 20px; }
        .bill-footer { border-top: 2px solid #2E7D32; padding-top: 15px; margin-top: 30px; }
        .company-name { font-size: 28px; font-weight: bold; color: #2E7D32; }
        .invoice-title { font-size: 24px; color: #333; }
        .status--active { color: #4CAF50; }
        .status-cancelled { color: #F44336; }
        @@media print {
            .no-print { display: none; }
            body { font-size: 12px; }
        }
    </style>
</head>
<body>
    <div class="container-fluid p-4">
        @if (clinic?.BillingHeaderLogo != null)
        {
            <div class="text-center mb-3">
                <img src="@clinic.BillingHeaderLogo" alt="Clinic Logo" style="max-height: 80px;">
            </div>
        }

        <div class="bill-header">
            <div class="row">
                <div class="col-8">
                    <h1 class="company-name mb-1">@(clinic?.ClinicName ?? "PhysioClinic Pro")</h1>
                    <p class="mb-0">@(clinic?.ClinicAddress ?? "")</p>
                    <p class="mb-0">
                        <i class="fas fa-phone me-2"></i>@(clinic?.ClinicPhone ?? "")
                        <i class="fas fa-envelope ms-3 me-2"></i>@(clinic?.ClinicEmail ?? "")
                    </p>
                </div>
                <div class="col-4 text-end">
                    <h2 class="invoice-title">INVOICE</h2>
                    <p class="mb-1"><strong>@Model.BillNumber</strong></p>
                    <p class="mb-0">Date: @Model.BillDate.ToString("dd-MMM-yyyy")</p>
                    <p class="mb-0">
                        Status: 
                        <span class="fw-bold @(Model.Status == "Active" ? "status-active" : "status-cancelled")">
                            @(Model.Status.ToUpper())
                        </span>
                    </p>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(clinic?.BillingHeaderText))
            {
                <div class="mt-2 p-2 bg-light rounded">
                    <small>@Html.Raw(clinic.BillingHeaderText)</small>
                </div>
            }
        </div>

        <div class="row mb-4">
            <div class="col-6">
                <h5 class="text-muted">Patient Details:</h5>
                <p class="mb-0"><strong>@Model.Patient?.PatientName</strong></p>
                <p class="mb-0">UHID: @Model.Patient?.UHID</p>
                <p class="mb-0">@(Model.Patient?.Address ?? "")</p>
                <p class="mb-0">@(Model.Patient?.City ?? "") @(Model.Patient?.State ?? "") @(Model.Patient?.Pincode ?? "")</p>
                <p class="mb-0">Mobile: @(Model.Patient?.MobileNumber ?? "")</p>
            </div>
        </div>

        <table class="table table-bordered mb-4">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Service Description</th>
                    <th class="text-center">Qty</th>
                    <th class="text-end">Rate (₹)</th>
                    <th class="text-end">Amount (₹)</th>
                    <th class="text-end">Disc (₹)</th>
                    <th class="text-end">GST (₹)</th>
                    <th class="text-end">Net (₹)</th>
                </tr>
            </thead>
            <tbody>
                @{ int i = 1; }
                @foreach (var detail in Model.BillDetails)
                {
                    <tr>
                        <td>@i</td>
                        <td>@detail.Service?.ServiceName</td>
                        <td class="text-center">@detail.Quantity</td>
                        <td class="text-end">@detail.Rate.ToString("N2")</td>
                        <td class="text-end">@detail.Amount.ToString("N2")</td>
                        <td class="text-end">@(((detail.Amount * detail.DiscountPercentage / 100) + detail.DiscountAmount).ToString("N2"))</td>
                        <td class="text-end">@detail.GSTAmount.ToString("N2")</td>
                        <td class="text-end fw-bold">@detail.NetAmount.ToString("N2")</td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>

        <div class="row">
            <div class="col-7">
                @if (Model.BillPayments.Any())
                {
                    <h6 class="text-muted">Payment Details:</h6>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Mode</th>
                                <th>Amount (₹)</th>
                                <th>Reference</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model.BillPayments)
                            {
                                <tr>
                                    <td>@payment.PaymentMode</td>
                                    <td>@payment.Amount.ToString("N2")</td>
                                    <td>@(payment.PaymentReference ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            <div class="col-5">
                <table class="table table-sm">
                    <tr>
                        <td><strong>Gross Amount:</strong></td>
                        <td class="text-end">₹@Model.TotalAmount.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td><strong>Discount:</strong></td>
                        <td class="text-end text-danger">-₹@Model.DiscountAmount.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td><strong>GST:</strong></td>
                        <td class="text-end">+₹@Model.GSTAmount.ToString("N2")</td>
                    </tr>
                    <tr class="table-secondary">
                        <td><strong>Net Amount:</strong></td>
                        <td class="text-end fw-bold fs-5">₹@Model.NetAmount.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td><strong>Paid Amount:</strong></td>
                        <td class="text-end text-success">₹@Model.PaidAmount.ToString("N2")</td>
                    </tr>
                    <tr class="@(Model.DueAmount > 0 ? "table-warning" : "")">
                        <td><strong>Due Amount:</strong></td>
                        <td class="text-end fw-bold @(Model.DueAmount > 0 ? "text-danger" : "")">₹@Model.DueAmount.ToString("N2")</td>
                    </tr>
                </table>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-6">
                <p class="text-muted small">
                    <strong>In Words:</strong> 
                    @{
                        var num = (long)Model.NetAmount;
                        var ones = new[] { "", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine" };
                        var tens = new[] { "", "", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety" };
                        var teens = new[] { "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen" };
                        
                        string NumberToWords(long n)
                        {
                            if (n == 0) return "Zero";
                            if (n < 0) return "Minus " + NumberToWords(-n);
                            
                            string words = "";
                            if (n >= 10000000) words += NumberToWords(n / 10000000) + " Crore "; n %= 10000000;
                            if (n >= 100000) words += NumberToWords(n / 100000) + " Lakh "; n %= 100000;
                            if (n >= 1000) words += NumberToWords(n / 1000) + " Thousand "; n %= 1000;
                            if (n >= 100) words += NumberToWords(n / 100) + " Hundred "; n %= 100;
                            if (n >= 20) words += tens[n / 10] + " " + ones[n % 10];
                            else if (n >= 10) words += teens[n - 10];
                            else words += ones[n];
                            
                            return words.Trim();
                        }
                    }
                    @NumberToWords(num) Rupees Only
                </p>
            </div>
        </div>

        <div class="bill-footer">
            @if (!string.IsNullOrEmpty(clinic?.BillingFooterText))
            {
                <div class="mb-3 p-2 bg-light rounded">
                    <small>@Html.Raw(clinic.BillingFooterText)</small>
                </div>
            }

            <div class="row">
                <div class="col-6">
                    @if (!string.IsNullOrEmpty(clinic?.FooterMessage))
                    {
                        <p class="text-muted small mb-0"><em>@clinic.FooterMessage</em></p>
                    }
                </div>
                <div class="col-6 text-end">
                    <p class="mb-1">For @((clinic?.ClinicName ?? "PhysioClinic Pro"))</p>
                    <br><br>
                    <p class="mb-0">Authorised Signatory</p>
                </div>
            </div>

            @if (clinic?.BillingFooterLogo != null)
            {
                <div class="text-center mt-3">
                    <img src="@clinic.BillingFooterLogo" alt="Footer Logo" style="max-height: 50px;">
                </div>
            }

            <p class="text-center text-muted small mt-3 mb-0">
                This is a computer-generated invoice. No signature required.
            </p>
        </div>

        <div class="no-print text-center mt-4">
            <button onclick="window.print()" class="btn btn-primary">
                <i class="fas fa-print me-2"></i>Print Bill
            </button>
            <a href="@Url.Action("Index", "Billing")" class="btn btn-secondary ms-2">
                <i class="fas fa-arrow-left me-2"></i>Back
            </a>
        </div>
    </div>
</body>
</html>